# Add this block to the Caddyfile the VPS already uses, then reload Caddy.
#
# Caddy installed on the server (systemd):
#     sudo nano /etc/caddy/Caddyfile        # paste the block
#     sudo systemctl reload caddy
#
# Caddy running in Docker: 127.0.0.1 inside that container is the container itself, not the VPS.
# Use the VPS's Docker bridge address instead:  reverse_proxy 172.17.0.1:3000
# and publish the app there: add APP_BIND=172.17.0.1:3000 to .env, then ./deploy/deploy.sh

revenueos.b2botix.ai {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
